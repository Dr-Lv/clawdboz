{
  "project_root": "/path/to/your/project",
  "feishu": {
    "app_id": "${FEISHU_APP_ID}",
    "app_secret": "${FEISHU_APP_SECRET}"
  },
  "qveris": {
    "api_key": "${QVERIS_API_KEY}"
  },
  "acp": {
    "clients": [
      {
        "id": "client_kimi",
        "name": "km",
        "type": "kimi",
        "executable": "/root/.local/bin/kimi",
        "enabled": true
      },
      {
        "id": "client_openclaw",
        "name": "openclaw",
        "type": "openclaw",
        "executable": "/usr/local/bin/openclaw",
        "session": "agent:main:main",
        "enabled": true
      },
      {
        "id": "client_hermes",
        "name": "hermes",
        "type": "hermes",
        "executable": "/usr/local/bin/hermes",
        "args": ["acp"],
        "enabled": true
      }
    ]
  },
  "logs": {
    "main_log": "logs/main.log",
    "debug_log": "logs/bot_debug.log",
    "feishu_api_log": "logs/feishu_api.log",
    "ops_log": "logs/ops_check.log"
  },
  "paths": {
    "workplace": "WORKPLACE",
    "user_images": "WORKPLACE/user_images",
    "user_files": "WORKPLACE/user_files",
    "mcp_config": ".agents/mcp.json",
    "skills_dir": ".agents/skills"
  },
  "start_script": "test_cancel.py"
}
